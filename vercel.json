{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|demo/|modelos/|brand/|favicon|robots\\.txt|version\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/conta?purge=1",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/pontes?cron=1",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/pontes.ts": {
      "maxDuration": 60
    }
  }
}
