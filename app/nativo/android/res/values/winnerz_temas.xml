<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Folha que sobe por cima da tela inicial (momento, ponto, objetivo, finalizar): fundo transparente e escurecido. -->
    <style name="WinnerZ.Folha" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#FFE6E9ED</item>
        <item name="android:textColorHighlight">#66E6E9ED</item>
    </style>
</resources>
