<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wc_raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fundo_widget" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/wc_traco" android:layout_width="6dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:src="@drawable/traco" android:importantForAccessibility="no" />
        <TextView android:id="@+id/wc_rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12.5sp" />
        <TextView android:id="@+id/wc_canto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="top" android:orientation="horizontal">
        <FrameLayout android:id="@+id/wc_capa_caixa" android:layout_width="42dp" android:layout_height="56dp" android:layout_marginEnd="11dp">
            <ImageView android:id="@+id/wc_capa" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/capa_vazia" android:importantForAccessibility="no" />
            <TextView android:id="@+id/wc_capa_txt" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom|end" android:padding="5dp" android:textColor="#9AA1AA" android:textSize="10sp" android:textStyle="bold" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/wc_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-condensed" android:maxLines="2" android:textColor="#E6E9ED" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/wc_linha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:textColor="#9AA1AA" android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="4dp" android:orientation="horizontal" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wc_b1" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="6dp" android:background="@drawable/botao_principal" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="30dp" android:text="" android:textColor="#07080A" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/wc_b2" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="6dp" android:background="@drawable/botao_sec" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="18dp" android:text="" android:textColor="#E6E9ED" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/wc_b3" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/botao_sec" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="18dp" android:text="" android:textColor="#E6E9ED" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
