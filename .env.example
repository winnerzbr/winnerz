# Supabase (Project Settings → API). Sem estas duas, o site roda em modo demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IGDB (usa credenciais da Twitch: dev.twitch.tv/console). Ficam só no servidor (Vercel).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Chave de serviço do Supabase, usada só pela função /api/igdb para gravar o cache de jogos.
# Nunca coloque esta chave em variáveis que comecem com VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
