<Project Sdk="Microsoft.NET.Sdk">
  <!-- Extensão do WinnerZ para o Playnite (lançador de jogos do PC). Compilada pelo GitHub (.github/workflows/playnite.yml). -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>WinnerZ</AssemblyName>
    <RootNamespace>WinnerZ</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <Product>WinnerZ</Product>
    <Company>WinnerZ</Company>
  </PropertyGroup>
  <ItemGroup>
    <!-- O Playnite já traz o próprio SDK: não vai junto na extensão. -->
    <PackageReference Include="PlayniteSDK" Version="6.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
