<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ws_raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fundo_widget" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/ws_traco" android:layout_width="6dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:src="@drawable/traco" android:importantForAccessibility="no" />
        <TextView android:id="@+id/ws_rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12.5sp" />
        <TextView android:id="@+id/ws_canto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="bottom" android:orientation="horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:orientation="vertical">
            <TextView android:id="@+id/ws_grande" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:includeFontPadding="false" android:maxLines="1" android:textColor="#E6E9ED" android:textSize="32sp" android:textStyle="bold" />
            <TextView android:id="@+id/ws_linha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/ws_barras" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:scaleType="fitXY" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="4dp" android:orientation="horizontal" />
    <TextView android:id="@+id/ws_rodape" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
</LinearLayout>
