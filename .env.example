# Supabase (Project Settings → API Keys). Sem estas duas, o site roda em modo demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ID do cliente do Google (público, não é a chave secreta). Com ele, o botão do Google é o oficial e a janela mostra
# "Prosseguir para winnerz.com.br". Sem ele, o login do Google passa pelo endereço do Supabase.
VITE_GOOGLE_CLIENT_ID=

# IGDB (usa credenciais da Twitch: dev.twitch.tv/console). Ficam só no servidor (Vercel).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Chave secreta do Supabase (sb_secret_...), usada só pela função /api/igdb para guardar as fichas dos jogos.
# Nunca coloque esta chave em variáveis que comecem com VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
