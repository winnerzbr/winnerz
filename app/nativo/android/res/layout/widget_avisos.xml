<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wa_raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fundo_widget" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/wa_traco" android:layout_width="6dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:src="@drawable/traco" android:importantForAccessibility="no" />
        <TextView android:id="@+id/wa_rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12.5sp" />
        <TextView android:id="@+id/wa_canto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/wa_vazio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#9AA1AA" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/wa_l1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/wa_t1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#E6E9ED" android:textSize="13.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/wa_q1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/wa_c1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/wa_fio2" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:layout_marginBottom="7dp" android:background="#1FE6E9ED" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/wa_l2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/wa_t2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#E6E9ED" android:textSize="13.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/wa_q2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/wa_c2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/wa_fio3" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:layout_marginBottom="7dp" android:background="#1FE6E9ED" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/wa_l3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/wa_t3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#E6E9ED" android:textSize="13.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/wa_q3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/wa_c3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/wa_fio4" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:layout_marginBottom="7dp" android:background="#1FE6E9ED" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/wa_l4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/wa_t4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#E6E9ED" android:textSize="13.5sp" android:textStyle="bold" />
                <TextView android:id="@+id/wa_q4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/wa_c4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#9AA1AA" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="4dp" android:orientation="horizontal" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/wa_b1" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="6dp" android:background="@drawable/botao_sec" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="18dp" android:text="" android:textColor="#E6E9ED" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
